---
/**
 * intro 页 · 通用 template
 *
 * 数据源: public/intro.config.json (各 intro 仓 build 时 cp 进来)
 * 静态资源: public/intro-zh.mp3 · public/avatar.svg · public/transcript.md
 *
 * 渲染: 99% 静态 HTML (0 JS) · 唯一 React island = AudioPlayer (client:load)
 */
import "../styles/shadcn.css"
import { AudioPlayer } from "../components/AudioPlayer"
import fs from "node:fs"
import path from "node:path"

const publicDir = path.resolve("./public")
const config = JSON.parse(fs.readFileSync(path.join(publicDir, "intro.config.json"), "utf-8"))

const transcriptPath = path.join(publicDir, "transcript.md")
const transcript = fs.existsSync(transcriptPath) ? fs.readFileSync(transcriptPath, "utf-8") : ""
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={config.accent} />
    <title>{config.name} · {config.role}</title>
    <meta name="description" content={config.role_long} />
  </head>
  <body class="bg-background text-foreground">
    <main class="max-w-xl mx-auto min-h-screen flex flex-col items-center justify-center px-6 py-16 gap-6 text-center">
      <!-- 头像 (用 img 让浏览器自动 scale · accent 浅色衬底 + 描边 跟老板品牌 pill 调性一致) -->
      <img
        src="/avatar.svg"
        alt={config.name}
        class="w-24 h-24 rounded-full border overflow-hidden"
        style={`background: ${config.accent}1a; border-color: ${config.accent}4d;`}
      />

      <!-- 名 + 角色 -->
      <div class="text-center space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight" data-testid="agent-name">{config.name}</h1>
        <p class="text-sm text-muted-foreground" data-testid="agent-role">{config.role}</p>
      </div>

      <!-- 自介音频 (React island) -->
      <AudioPlayer
        client:load
        src={config.mp3_url}
        label={`听${config.name_short}的自我介绍`}
      />

      <!-- 文字稿 (Apple Podcasts 同款 · 直接淡灰小字显示 · 不要丑开关) -->
      {transcript && (
        <div class="w-full max-w-md text-left text-sm leading-relaxed text-muted-foreground whitespace-pre-line mt-2" data-testid="transcript">
          {transcript}
        </div>
      )}

      <!-- 主 CTA · pill 胶囊形跳 chat -->
      <a
        href={config.chat_url}
        class="inline-block px-7 py-3 bg-primary text-primary-foreground rounded-full text-sm font-medium hover:opacity-90 active:scale-[0.98] shadow-sm hover:shadow transition-all"
        data-testid="cta-chat"
      >
        {config.cta_label}
      </a>

      <!-- 微信扫码加群 (config 有 qrcode_url 才渲染) -->
      {config.qrcode_url && (
        <div class="flex flex-col items-center gap-2 mt-8 pt-8 border-t border-border w-full">
          <p class="text-sm font-medium">{config.qrcode_label}</p>
          {config.qrcode_sub && <p class="text-xs text-muted-foreground">{config.qrcode_sub}</p>}
          <img src={config.qrcode_url} alt="加群二维码" class="w-40 h-40 rounded-2xl border border-border mt-2" />
        </div>
      )}

      <!-- footer -->
      <footer class="text-xs text-muted-foreground/70 mt-12" data-testid="footer">
        {config.footer}
      </footer>
    </main>
  </body>
</html>
