---
/**
 * intro 页 · 通用 template
 *
 * 数据源: public/intro.config.json (各 intro 仓 build 时 cp 进来)
 * 静态资源: public/intro-zh.mp3 · public/avatar.svg · public/transcript.md
 *
 * 渲染: 99% 静态 HTML (0 JS) · 唯一 React island = AudioPlayer (client:load)
 */
import "../styles/shadcn.css"
import { AudioPlayer } from "../components/AudioPlayer"
import fs from "node:fs"
import path from "node:path"

const publicDir = path.resolve("./public")
const config = JSON.parse(fs.readFileSync(path.join(publicDir, "intro.config.json"), "utf-8"))

const transcriptPath = path.join(publicDir, "transcript.md")
const transcript = fs.existsSync(transcriptPath) ? fs.readFileSync(transcriptPath, "utf-8") : ""
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={config.accent} />
    <title>{config.name} · {config.role}</title>
    <meta name="description" content={config.role_long} />
  </head>
  <body class="bg-background text-foreground">
    <main class="max-w-xl mx-auto min-h-[100dvh] flex flex-col px-6 py-5 lg:py-8 text-center">
      <!-- 主内容垂直居中 -->
      <div class="flex-1 flex flex-col items-center justify-center">
        <!-- 头像 -->
        <img
          src="/avatar.svg"
          alt={config.name}
          class="w-28 h-28 lg:w-32 lg:h-32 rounded-full border-2 overflow-hidden"
          style={`background: ${config.accent}1a; border-color: ${config.accent}4d;`}
        />

        <!-- 名 + 角色 -->
        <h1 class="mt-4 lg:mt-6 text-2xl lg:text-3xl font-semibold tracking-tight" data-testid="agent-name">{config.name}</h1>
        <p class="mt-1.5 lg:mt-2 text-base lg:text-lg text-muted-foreground" data-testid="agent-role">{config.role}</p>

        <!-- 听音频 -->
        <div class="mt-8 lg:mt-12">
          <AudioPlayer
            client:load
            src={config.mp3_url}
            label={`听${config.name_short}的自我介绍`}
          />
        </div>

        <!-- 主 CTA · 跟音频按钮同尺寸 (颜色已区分主次 · 不再字号区分) -->
        <a
          href={config.chat_url}
          class="mt-5 lg:mt-8 inline-flex items-center px-6 py-2 bg-primary text-primary-foreground rounded-full text-base font-medium hover:opacity-95 active:scale-[0.98] shadow-sm hover:shadow transition-all min-h-[3.75rem]"
          data-testid="cta-chat"
        >
          {config.cta_label}
        </a>

        <!-- 微信扫码加群 · 次要视觉 (留白分隔 · 不用线) -->
        {config.qrcode_url && (
          <div class="mt-10 lg:mt-14 w-full flex flex-col items-center">
            <p class="text-xs lg:text-sm text-muted-foreground">{config.qrcode_label}</p>
            <img src={config.qrcode_url} alt="加群二维码" class="mt-3 lg:mt-4 w-32 h-32 lg:w-40 lg:h-40 rounded-xl border border-border opacity-90" />
          </div>
        )}
      </div>

      <!-- footer · 永远在底 -->
      <footer class="pt-4 text-[10px] lg:text-xs text-muted-foreground/70 shrink-0" data-testid="footer">
        {config.footer}
      </footer>
    </main>
  </body>
</html>
